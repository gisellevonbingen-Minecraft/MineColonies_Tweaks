	<label id="buildingName" size="100% 11" pos="0 25" color="black"
		textalign="MIDDLE" label="BUILDINGNAME" />

	<box size="164 200" linewidth="1" pos="13 38">
		<list id="resources" size="100% 100%">
			<box size="100% 22" linewidth="1">
				<image id="icon" size="20 20" pos="1 1" />
				<label id="text" size="101 100%" pos="22 0" color="black"
					tooltip="TOOLTIP" />
				<button id="remove" size="30 15" pos="124 3" label="X"
					color="red"
					source="minecolonies:textures/gui/builderhut/builder_button_medium.png" />
			</box>
		</list>
	</box>
</window>